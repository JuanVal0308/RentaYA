## Copia este archivo como local.properties (ya está en .gitignore).
## Android Studio genera sdk.dir automáticamente.
## Las claves Supabase ya vienen en supabase.properties del repo;
## solo agrégalas aquí si quieres SOBREESCRIBIR las del repo.

# sdk.dir=C:\\Users\\TU_USUARIO\\AppData\\Local\\Android\\Sdk

# Opcional (override):
# SUPABASE_URL=https://TU_PROYECTO.supabase.co
# SUPABASE_ANON_KEY=tu_clave_anon_publica

# Solo debug: no usar en demos a inversionistas ni en release.
# DEBUG_OMITIR_VERIFICACION_CORREO=true
